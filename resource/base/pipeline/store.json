{
    "Store": {
        "action": {
            "type": "Custom",
            "param": { "custom_action": "navigation_guard" }
        },
        "next": [
            "[JumpBack]CancelFortuneFruitSpend",
            "[JumpBack]ClosePlayerProfile",
            "[JumpBack]LeaveCurrentPage",
            "[JumpBack]CloseGift",
            "[JumpBack]CloseByClickBlank",
            "[JumpBack]CardPage",
            "[JumpBack]HomePage",
            "SearchStoreLeft"
        ]
    },
    "SearchStoreLeft": {
        "action": {
            "type": "Custom",
            "param": { "custom_action": "store_search_bounded" }
        },
        "next": ["Groceries"],
        "max_hit": 12
    },
    "SearchStoreRight": {
        "next": [
            "[JumpBack]ClosePlayerProfile",
            "OpenStore",
            "RightEdgeInSearchStore",
            "[JumpBack]SwipeRight"
        ],
        "max_hit": 12
    },
    "OpenStore": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    4,
                    659,
                    716,
                    190
                ],
                "template": [
                    "store/store1.png",
                    "store/store2.png",
                    "store/store3.png",
                    "store/store4.png"
                ]
            }
        },
        "action": "Click",
        "post_delay": 2000,
        "next": [
            "OpenStore", // 没进入杂货商店页面就继续识别商店
            "Groceries" // 先买杂货商店
        ]
    },
    "LeftEdgeInSearchStore": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "furniture/airship1.png",
                    "furniture/airship2.png",
                    "furniture/airship3.png"
                ]
            }
        },
        "next": [
            "SearchStoreRight"
        ]
    },
    // 主页的右边缘
    "RightEdgeInSearchStore": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": [
                    "furniture/fireplace_light1.png",
                    "furniture/fireplace_light_snow1.png",
                    "furniture/fireplace_night1.png",
                    "furniture/fireplace_night2.png",
                    "furniture/fireplace_night_snow1.png",
                    "furniture/fireplace_night_snow2.png"
                ]
            }
        }
    },
    "Groceries": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    146,
                    1171,
                    566,
                    96
                ],
                "expected": [
                    "杂货"
                ]
            }
        },
        "action": {
            "type": "Click"
        },
        "post_delay": 1000,
        "next": [
            "GroceriesPurchase"
        ]
    },
