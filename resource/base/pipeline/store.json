    "GroceryInsufficientGold": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [0,0,720,1280],
                "expected": ["金币不足", "金币不够", "货币不足"]
            }
        },
        "action": { "type": "DoNothing" },
        "post_delay": 1200,
        "next": ["Treasure"],
        "focus": {
            "Node.Recognition.Succeeded": {
                "content": "金币不足，停止本轮杂货购买并禁止刷新",
                "display": ["log", "toast"]
            }
        }
    },
    "StopGroceryRefresh": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    478,
                    100,
                    38,
                    36
                ],
                "expected": [
                    "(?<![0-9])0(?![0-9])"
