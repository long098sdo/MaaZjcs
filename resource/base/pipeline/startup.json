                    183,
                    978,
                    102,
                    30
                ],
                "expected": [
                    "下载"
                ]
            }
        },
        "inverse": true
    },
    "WaitConfirmButtonGone": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    233,
